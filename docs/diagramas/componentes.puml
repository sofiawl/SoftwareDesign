@startuml componentes
title Diagrama de componentes - Gerenciamento de estágios\n(monólito modular em camadas com MVC)
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 60
top to bottom direction

package "Apresentação" {
  component "Controllers\nLoginController, VagaController, EstagioController,\nAcompanhamentoController, SituacaoController" as Ctrl
  component "Sessao\nidentifica o Solicitante\npelo cookie" as Sessao
  component "Views\ntelas de vaga, candidatura,\nestágio e situação" as Views
}

package "Aplicação" {
  component "Casos de uso\nCadastrarVaga, Candidatar, DecidirCandidatura,\nHomologarEstagio, EntregarDocumento, RecusarDocumento,\nRegistrarAtividade, EncerrarEstagio, ConsultarSituacao,\nListarPainel" as UC
  component "Interfaces\nRepositorioProcesso, LeituraSituacao, Notificador,\nAviso, TipoEvento, ResultadoAviso, AvisoPendente" as Intf
}

package "Domínio" {
  component "Vagas\nVaga, Candidatura" as Vagas
  component "Estágio\nEstagio" as Estagio
  component "Acompanhamento\nDocumento, Atividade" as Acomp
  component "Política de estágio\nPoliticaEstagio, PoliticaRegulamentoVigente,\nRecortePorPapel, TipoDocumento,\nSituacaoProcesso, SituacaoVisivel" as Pol
}

package "Infraestrutura" {
  component "RepositorioPersistente\n(RNF02)" as Repo
  component "NotificadorSimulado\n(RNF04)" as Notif
  component "CadastroUsuarios\n(identidade)" as Cadastro
}

component "Composição (Main)\nescolhe as implementações\ne monta os Controllers" as Main

' ---------- Apresentação -> Aplicação ----------
Ctrl -right-> Views : escolhe e entrega\nSituacaoVisivel
Ctrl -down-> UC : chama um\ncaso de uso
Ctrl -right-> Sessao : pede o Solicitante

' ---------- Aplicação -> Domínio ----------
UC -right-> Intf
UC -down-> Vagas
UC -down-> Estagio
UC -down-> Acomp
UC -down-> Pol
Intf -down-> Vagas
Intf -down-> Estagio
Intf -down-> Pol

' ---------- Dentro do Domínio ----------
Estagio -left-> Vagas
Estagio -down-> Acomp
Estagio -down-> Pol
Acomp -right-> Pol

' ---------- Infraestrutura implementa a Aplicação ----------
Repo .up.> Intf : <<implementa>>\nRepositorioProcesso,\nLeituraSituacao
Notif .up.> Intf : <<implementa>>\nNotificador

' ---------- Composição ----------
Main .up.> Repo : <<instancia>>
Main .up.> Notif : <<instancia>>
Main .up.> Cadastro : <<instancia>>
Main .up.> Sessao : <<instancia>>\nentrega buscar e listar\nde CadastroUsuarios
Main .up.> Ctrl : <<instancia>>

@enduml
