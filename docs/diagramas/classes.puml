@startuml classes
title Diagrama de classes - Homologação de estágio (recorte do sistema)

skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.8
skinparam ArrowColor #222222
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor<<app>> #DCE8FF
skinparam ClassBackgroundColor<<contrato>> #D5F2DC
skinparam ClassBackgroundColor<<dominio>> #FFE9C7
skinparam ClassBackgroundColor<<infra>> #E8D9FF
hide stereotype
hide empty members
hide circle

' ---------- Aplicação ----------
class HomologarEstagio <<app>> {
  +executar(solicitante, candidaturaId, orientadorId)
}

' ---------- Contratos (interfaces estáveis) ----------
interface PoliticaEstagio <<contrato>> {
  +documentosObrigatorios()
  +podeDecidir(etapa, papel)
}
interface RepositorioProcesso <<contrato>> {
  +buscarVagaDaCandidatura(candidaturaId)
  +salvarEstagio(estagio)
  +salvarAvisoPendente(aviso, motivo)
}
interface Notificador <<contrato>> {
  +notificar(aviso)
}

' ---------- Domínio ----------
class Estagio <<dominio>> {
  -candidaturaId
  -orientadorId
  -estado
  +{static} homologar(candidatura, orientadorId, tipos)
  +registrarAtividade(data, descricao, horas)
  +encerrar(motivo)
}
class Documento <<dominio>> {
  -tipo
  -estado
  +entregar()
  +recusar(motivo)
}
class Atividade <<dominio>> {
  -data
  -descricao
  -cargaHoraria
}
class Vaga <<dominio>> {
  -concedenteId
  -estado
  +candidatar(estudanteId)
  +candidatura(candidaturaId)
}
class Candidatura <<dominio>> {
  -estudanteId
  -estado
  +aceitar()
  +recusar(motivo)
  +estaAceita()
}

' ---------- Implementações (fora do núcleo) ----------
class PoliticaRegulamentoVigente <<infra>>
class RepositorioPersistente <<infra>>
class NotificadorSimulado <<infra>>

' ---------- Dependências do caso de uso ----------
HomologarEstagio ..> PoliticaEstagio
HomologarEstagio ..> RepositorioProcesso
HomologarEstagio ..> Notificador
HomologarEstagio ..> Estagio

' ---------- Realizações ----------
PoliticaEstagio <|.. PoliticaRegulamentoVigente
RepositorioProcesso <|.. RepositorioPersistente
Notificador <|.. NotificadorSimulado

' ---------- Composições (a parte não existe sem o todo) ----------
Estagio "1" *-- "1..*" Documento
Estagio "1" *-- "0..*" Atividade
Vaga "1" *-- "0..*" Candidatura

' ---------- Dependência de domínio ----------
Estagio ..> Candidatura

legend right
  Azul: aplicação | Verde: contratos (interfaces)
  Laranja: domínio | Roxo: implementações
endlegend
@enduml